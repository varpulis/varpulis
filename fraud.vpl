connector Mqtt = mqtt(host: "localhost", port: 1883, client_id: "demo")
event SensorReading:
    device_id: str
    temperature: float
    location: str
event Transaction:
    device_id: str
    amount: float
    merchant: str
stream HotDevices = SensorReading .from(Mqtt, topic: "devices/sensors") .where(temperature > 80) .emit(device: device_id, temp: temperature)
stream LargePayments = Transaction .from(Mqtt, topic: "payments/tx") .where(amount > 5000) .emit(device: device_id, amount: amount)
stream Alert = HotDevices as h -> LargePayments as p .within(2m) .where(h.device == p.device) .emit(device: h.device, temp: h.temp, amount: p.amount)