{
  "name": "varpulis-control-plane",
  "version": "0.6.0",
  "description": "Varpulis Control Plane Web UI - Operational dashboard for pipeline monitoring and cluster management",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "test": "playwright test tests/e2e.spec.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e.spec.ts",
    "test:headed": "playwright test tests/e2e.spec.ts --headed",
    "test:auth": "K3D_SAAS=1 playwright test tests/auth.spec.ts --project=k3d-saas",
    "test:auth:headed": "K3D_SAAS=1 playwright test tests/auth.spec.ts --project=k3d-saas --headed"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@mdi/font": "^7.4.47",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.41.5",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "pinia": "^3.0.4",
    "reconnecting-websocket": "^4.4.0",
    "vue": "^3.5.30",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.3",
    "vuetify": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.4.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.6.1",
    "jsdom": "^28.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.1",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
