# MITRE ATT&CK: T1003 -- OS Credential Dumping
# Tactic: Credential Access (TA0006)
# URL: https://attack.mitre.org/techniques/T1003/
#
# Detects: A privilege escalation event followed by the execution of a
# known credential dumping tool (lsass access, mimikatz, procdump targeting
# lsass, secretsdump, etc.) on the same host within 5 minutes.
#
# The sequence matters: escalation THEN dump. An attacker needs elevated
# privileges before they can access LSASS memory or SAM database.
#
# Data sources:
#   - Windows Event Log: EventID 4672 (special privileges), 4688 (process creation)
#   - Sysmon: EventID 1 (process create), EventID 10 (process access to lsass)
#   - EDR: Process telemetry with command line arguments
#
# Severity: Critical
# False positive rate: Very low (escalation + cred dump is a clear attack chain)
#
# Test events (should trigger):
#   PrivEscEvent { host: "ws-finance-01", user: "jdoe", method: "token_impersonation", new_privilege: "SYSTEM" }
#   CredDumpEvent { host: "ws-finance-01", process_name: "mimikatz.exe", target: "lsass.exe", user: "SYSTEM" }

event PrivEscEvent:
    host: str
    user: str
    method: str
    new_privilege: str

event CredDumpEvent:
    host: str
    process_name: str
    target: str
    user: str

stream CredDumpAfterEscalation = PrivEscEvent as escalation
    -> CredDumpEvent where host == escalation.host as dump
    .within(5m)
    .emit(
        technique: "T1003",
        tactic: "credential_access",
        severity: "critical",
        host: escalation.host,
        escalation_user: escalation.user,
        escalation_method: escalation.method,
        new_privilege: escalation.new_privilege,
        dump_tool: dump.process_name,
        dump_target: dump.target,
        description: "Credential dump after privilege escalation"
    )
