# MITRE ATT&CK: T1110.003 -- Brute Force: Password Spraying
# Tactic: Credential Access (TA0006)
# URL: https://attack.mitre.org/techniques/T1110/003/
#
# Detects: Failed login attempts to 5+ different user accounts from the
# same source IP within 10 minutes. Unlike brute force (many passwords
# against one account), password spraying tries one or a few passwords
# against many accounts to avoid lockout thresholds.
#
# Data sources:
#   - Windows Event Log: EventID 4625 (failed logon)
#   - Azure AD: Sign-in logs with failure reason
#   - Linux: /var/log/auth.log
#   - Cloud: AWS CloudTrail ConsoleLogin failures
#
# Severity: High
# False positive rate: Low (5+ distinct accounts from one IP is abnormal)
#
# Test events (should trigger):
#   SprayEvent { source_ip: "10.0.0.99", username: "user1", status: "failed", target_host: "dc01" }
#   SprayEvent { source_ip: "10.0.0.99", username: "user2", status: "failed", target_host: "dc01" }
#   SprayEvent { source_ip: "10.0.0.99", username: "user3", status: "failed", target_host: "dc01" }
#   SprayEvent { source_ip: "10.0.0.99", username: "user4", status: "failed", target_host: "dc01" }
#   SprayEvent { source_ip: "10.0.0.99", username: "user5", status: "failed", target_host: "dc01" }

event SprayEvent:
    source_ip: str
    username: str
    status: str
    target_host: str

stream PasswordSpray = SprayEvent where status == "failed" as f1
    -> SprayEvent where status == "failed" as f2
    -> SprayEvent where status == "failed" as f3
    -> SprayEvent where status == "failed" as f4
    -> SprayEvent where status == "failed" as f5
    .within(10m)
    .where(
        f1.source_ip == f2.source_ip
        and f2.source_ip == f3.source_ip
        and f3.source_ip == f4.source_ip
        and f4.source_ip == f5.source_ip
        and f1.username != f2.username
        and f2.username != f3.username
        and f3.username != f4.username
        and f4.username != f5.username
    )
    .emit(
        technique: "T1110.003",
        tactic: "credential_access",
        severity: "high",
        source_ip: f1.source_ip,
        target_host: f1.target_host,
        targeted_accounts: 5,
        description: "Password spray: failed logins to 5+ distinct accounts from same IP"
    )
