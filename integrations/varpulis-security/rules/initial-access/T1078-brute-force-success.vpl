# MITRE ATT&CK: T1078.001 -- Valid Accounts: Brute Force
# Tactic: Initial Access (TA0001)
# URL: https://attack.mitre.org/techniques/T1078/001/
#
# Detects: 5+ failed login attempts followed by a successful login
# from the same source IP within 10 minutes. This pattern indicates
# an attacker guessing credentials until they find a valid combination.
#
# Data sources:
#   - Windows Event Log: EventID 4625 (failed), 4624 (success)
#   - Linux: /var/log/auth.log (sshd)
#   - Cloud: AWS CloudTrail ConsoleLogin, Azure AD Sign-in logs
#
# Severity: High
# False positive rate: Low (5 failures + success from same IP is strong signal)
#
# Test events (should trigger):
#   AuthEvent { source_ip: "10.0.0.50", username: "admin", status: "failed", target_host: "dc01" }
#   (repeat 4 more times)
#   AuthEvent { source_ip: "10.0.0.50", username: "admin", status: "success", target_host: "dc01" }
#
# Test events (should NOT trigger):
#   AuthEvent { source_ip: "192.168.1.10", username: "jsmith", status: "failed", target_host: "web01" }
#   AuthEvent { source_ip: "192.168.1.10", username: "jsmith", status: "success", target_host: "web01" }

event AuthEvent:
    source_ip: str
    username: str
    status: str
    target_host: str

stream BruteForceSuccess = AuthEvent where status == "failed" as f1
    -> AuthEvent where status == "failed" as f2
    -> AuthEvent where status == "failed" as f3
    -> AuthEvent where status == "failed" as f4
    -> AuthEvent where status == "failed" as f5
    -> AuthEvent where status == "success" as success
    .within(10m)
    .where(f1.source_ip == success.source_ip)
    .emit(
        technique: "T1078.001",
        tactic: "initial_access",
        severity: "high",
        source_ip: f1.source_ip,
        username: success.username,
        target_host: success.target_host,
        failed_attempts: 5,
        description: "Brute force attack succeeded"
    )
