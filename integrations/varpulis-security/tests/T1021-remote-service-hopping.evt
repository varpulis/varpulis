# T1021 -- Remote Services: Service Hopping
# Tests for: rules/lateral-movement/T1021-remote-service-hopping.vpl
#
# Expected results:
#   - POSITIVE: 1 RemoteServiceHopping alert (10.0.0.5 -> server-a -> server-b)
#   - NEGATIVE: No alert for legitimate admin single-hop

# =============================================================================
# POSITIVE CASE: Attacker hops from server-a to server-b
# Expected: 1 alert
# =============================================================================

BATCH 0
RemoteLogin { source_ip: "10.0.0.5", target_host: "server-a", user: "attacker", protocol: "rdp" }

BATCH 120000
RemoteLogin { source_ip: "server-a", target_host: "server-b", user: "attacker", protocol: "rdp" }

# =============================================================================
# NEGATIVE CASE: Single RDP login with no subsequent hop
# Expected: No alert (only one RemoteLogin, no second hop)
# =============================================================================

BATCH 600000
RemoteLogin { source_ip: "admin-ws", target_host: "prod-server", user: "sysadmin", protocol: "ssh" }

# =============================================================================
# NEGATIVE CASE: Two logins to different hosts, but second does not originate
# from the first target (no hop relationship)
# Expected: No alert (source_ip of hop2 != target_host of hop1)
# =============================================================================

BATCH 900000
RemoteLogin { source_ip: "10.0.0.20", target_host: "web-01", user: "devops", protocol: "ssh" }

BATCH 910000
RemoteLogin { source_ip: "10.0.0.21", target_host: "web-02", user: "devops", protocol: "ssh" }
