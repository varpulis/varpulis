# T1110.003 -- Password Spraying
# Tests for: rules/credential-access/T1110-password-spray.vpl
#
# Expected results:
#   - POSITIVE: 1 PasswordSpray alert for source IP 10.0.0.99
#   - NEGATIVE: No alert for failures to the same account (brute force, not spray)

# =============================================================================
# POSITIVE CASE: Failed logins to 5 different accounts from same IP
# Expected: 1 alert
# =============================================================================

BATCH 0
SprayEvent { source_ip: "10.0.0.99", username: "user1", status: "failed", target_host: "dc01" }

BATCH 5000
SprayEvent { source_ip: "10.0.0.99", username: "user2", status: "failed", target_host: "dc01" }

BATCH 10000
SprayEvent { source_ip: "10.0.0.99", username: "user3", status: "failed", target_host: "dc01" }

BATCH 15000
SprayEvent { source_ip: "10.0.0.99", username: "user4", status: "failed", target_host: "dc01" }

BATCH 20000
SprayEvent { source_ip: "10.0.0.99", username: "user5", status: "failed", target_host: "dc01" }

# =============================================================================
# NEGATIVE CASE: 5 failures but same username (brute force, not spray)
# Expected: No alert (username != check fails because all usernames are the same)
# =============================================================================

BATCH 300000
SprayEvent { source_ip: "10.0.0.200", username: "admin", status: "failed", target_host: "dc01" }

BATCH 305000
SprayEvent { source_ip: "10.0.0.200", username: "admin", status: "failed", target_host: "dc01" }

BATCH 310000
SprayEvent { source_ip: "10.0.0.200", username: "admin", status: "failed", target_host: "dc01" }

BATCH 315000
SprayEvent { source_ip: "10.0.0.200", username: "admin", status: "failed", target_host: "dc01" }

BATCH 320000
SprayEvent { source_ip: "10.0.0.200", username: "admin", status: "failed", target_host: "dc01" }

# =============================================================================
# NEGATIVE CASE: 5 different accounts but from different IPs
# Expected: No alert (source_ip == check fails)
# =============================================================================

BATCH 600000
SprayEvent { source_ip: "172.16.0.1", username: "acct_a", status: "failed", target_host: "dc01" }

BATCH 605000
SprayEvent { source_ip: "172.16.0.2", username: "acct_b", status: "failed", target_host: "dc01" }

BATCH 610000
SprayEvent { source_ip: "172.16.0.3", username: "acct_c", status: "failed", target_host: "dc01" }

BATCH 615000
SprayEvent { source_ip: "172.16.0.4", username: "acct_d", status: "failed", target_host: "dc01" }

BATCH 620000
SprayEvent { source_ip: "172.16.0.5", username: "acct_e", status: "failed", target_host: "dc01" }
