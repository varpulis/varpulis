# T1003 -- Credential Dump After Escalation
# Tests for: rules/credential-access/T1003-credential-dump-after-escalation.vpl
#
# Expected results:
#   - POSITIVE: 1 CredDumpAfterEscalation alert on host ws-finance-01
#   - NEGATIVE: No alert for credential dump without prior escalation

# =============================================================================
# POSITIVE CASE: Privilege escalation then mimikatz on same host
# Expected: 1 alert
# =============================================================================

BATCH 0
PrivEscEvent { host: "ws-finance-01", user: "jdoe", method: "token_impersonation", new_privilege: "SYSTEM" }

BATCH 30000
CredDumpEvent { host: "ws-finance-01", process_name: "mimikatz.exe", target: "lsass.exe", user: "SYSTEM" }

# =============================================================================
# NEGATIVE CASE: Credential dump on a different host (no prior escalation on that host)
# Expected: No alert (escalation was on ws-finance-01, dump is on ws-dev-03)
# =============================================================================

BATCH 300000
CredDumpEvent { host: "ws-dev-03", process_name: "procdump.exe", target: "lsass.exe", user: "admin" }

# =============================================================================
# NEGATIVE CASE: Escalation only, no subsequent dump
# Expected: No alert (sequence incomplete)
# =============================================================================

BATCH 600000
PrivEscEvent { host: "ws-hr-02", user: "msmith", method: "exploit", new_privilege: "admin" }

# =============================================================================
# NEGATIVE CASE: Escalation then dump but outside the 5 minute window
# Expected: No alert (events too far apart for .within(5m))
# =============================================================================

BATCH 900000
PrivEscEvent { host: "ws-it-01", user: "kbrown", method: "dll_hijack", new_privilege: "SYSTEM" }

BATCH 1260000
CredDumpEvent { host: "ws-it-01", process_name: "mimikatz.exe", target: "sam", user: "SYSTEM" }
