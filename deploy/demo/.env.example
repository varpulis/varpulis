# Varpulis Demo Environment
# Copy to .env and update values before deploying.

# API key for coordinator <-> worker authentication and UI access
VARPULIS_API_KEY=change-me
VARPULIS_WORKER_KEY=change-me

# Rust log level
RUST_LOG=info

# Grafana credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# MinIO (S3-compatible model storage)
MINIO_USER=varpulis
MINIO_PASSWORD=change-me

# AI Assistant (Ollama runs locally, no key needed)
# Override for paid providers:
# VARPULIS_LLM_ENDPOINT=https://api.anthropic.com/v1
# VARPULIS_LLM_MODEL=claude-sonnet-4-5-20250929
# VARPULIS_LLM_API_KEY=sk-ant-...
# VARPULIS_LLM_PROVIDER=anthropic

# PostgreSQL (SaaS billing & user DB)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://varpulis:change-me@postgres:5432/varpulis

# GitHub OAuth (required for login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT secret (auto-generated if not set, but set for consistency across nodes)
JWT_SECRET=change-me-jwt-secret

# Stripe billing (optional — leave empty to disable)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# URLs for OAuth redirects
FRONTEND_URL=https://demo.varpulis-cep.com
SERVER_URL=https://demo.varpulis-cep.com
