demo.varpulis-cep.com, www.varpulis-cep.com {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

    # API requests -> cookie-sticky across 3 coordinators
    reverse_proxy /api/* coordinator-1:9100 coordinator-2:9100 coordinator-3:9100 {
        lb_policy cookie
        health_uri /health
        health_interval 10s
    }

    # WebSocket -> cookie-sticky across 3 coordinators
    reverse_proxy /ws coordinator-1:9100 coordinator-2:9100 coordinator-3:9100 {
        lb_policy cookie
        health_uri /health
        health_interval 10s
    }

    # Grafana dashboard (matches /grafana and /grafana/*)
    @grafana path /grafana /grafana/*
    reverse_proxy @grafana grafana:3000

    # Auth endpoints -> coordinators (for login/signup)
    reverse_proxy /auth/* coordinator-1:9100 coordinator-2:9100 coordinator-3:9100 {
        lb_policy cookie
        health_uri /health
        health_interval 10s
    }

    # Everything else -> web-ui (SPA with all routes: landing, auth, control plane)
    reverse_proxy /* web-ui:8080
}

# Blog subdomain -> rewrite root to /blog, proxy to web-ui
blog.varpulis-cep.com {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
    rewrite / /blog
    reverse_proxy web-ui:8080
}

# Docs subdomain -> rewrite root to /docs, proxy to web-ui
docs.varpulis-cep.com {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
    rewrite / /docs
    reverse_proxy web-ui:8080
}

# Register subdomain -> rewrite root to /signup, proxy to web-ui
register.varpulis-cep.com {
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
    rewrite / /signup
    reverse_proxy web-ui:8080
}
