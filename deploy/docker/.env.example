# Varpulis SaaS Deployment — Environment Variables
# Copy to .env and fill in all values before deploying.
#
# Required:
#   POSTGRES_PASSWORD, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET
#
# Optional (Stripe billing):
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRO_PRICE_ID

# ── Core ──────────────────────────────────────────────────────
VARPULIS_API_KEY=change-me-to-a-random-string
RUST_LOG=info
VARPULIS_RATE_LIMIT=1000

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password

# ── GitHub OAuth ──────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: https://your-domain.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ── Stripe Billing (optional) ────────────────────────────────
# Leave empty to disable billing features.
# Dashboard: https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com
SERVER_URL=https://your-domain.com

# ── Caddy ─────────────────────────────────────────────────────
# Set to your domain for automatic HTTPS via Let's Encrypt
# Use "localhost" for local development
SITE_ADDRESS=localhost

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
