connector Mqtt = mqtt(host: "localhost", port: 1883)
event SensorReading:
device_id: str
temperature: float
location: str
event Transaction:
device_id: str
amount: float
merchant: str
stream HotDevices = SensorReading .where(temperature > 80) .emit(device: device_id, temp: temperature)
stream LargePayments = Transaction .where(amount > 5000) .emit(device: device_id, amount: amount, merchant: merchant)
stream Alert = HotDevices as h -> LargePayments as p .within(2m) .where(h.device == p.device) .emit(device: h.device, temp: h.temp, amount: p.amount)