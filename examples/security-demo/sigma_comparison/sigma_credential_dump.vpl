# Sigma-equivalent VPL: Detect Mimikatz by filename (same as Sigma rule)
# This rule demonstrates Sigma's approach: static string matching on the source binary name.
# It will MISS renamed Mimikatz, reflective loading, comsvcs.dll, and custom dumpers.
#
# Based on: https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_hktl_mimikatz.yml

event SysmonProcessAccess:
    SourceImage: str
    TargetImage: str
    GrantedAccess: str
    CallTrace: str
    Hostname: str
    ProcessId: int

stream SigmaStyleMimikatz = SysmonProcessAccess
    .where(SourceImage.contains("mimikatz"))
    .emit(
        event_type: "SigmaAlert",
        rule: "sigma_mimikatz",
        host: Hostname,
        source_image: SourceImage,
        target_image: TargetImage,
        access_rights: GrantedAccess
    )
