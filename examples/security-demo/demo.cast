[52.805897, "o", "\u001b[1m\u001b[32mSimulation Complete\u001b[39m\u001b[0m\r\n======================\r\nDuration:         101.796201ms\r\nEvents processed: 6\r\nWorkers used:     1\r\nOutput events emitted: 1\r\nEvent rate:       \u001b[36m58.9 events/sec\u001b[39m\r\n\r\nOutput Events Summary:\r\n  - BehavioralPsExec: {\"event_type\": Str(\"KillChainAlert\"), \"rule\": Str(\"behavioral_psexec\"), \"mitre\": Str(\"T1021.002,T1036.003\"), \"severity\": Str(\"critical\"), \"source_host\": Str(\"WS01\"), \"target_ip\": Str(\"10.0.0.10\"), \"source_image\": Str(\"C:\\\\Users\\\\attacker\\\\tools\\\\svcupdate.exe\"), \"remote_parent\": Str(\"C:\\\\Windows\\\\System32\\\\services.exe\"), \"remote_process\": Str(\"C:\\\\Windows\\\\System32\\\\cmd.exe\"), \"remote_cmdline\": Str(\"cmd.exe /c whoami && hostname && ipconfig\"), \"remote_host\": Str(\"DC01\"), \"sigma_would_miss\": Str(\"true\"), \"summary\": Str(\"PsExec-like lateral movement detected via behavioral analysis (binary name independent)\")}\r\n"]
