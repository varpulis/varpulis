[56.809335, "o", "\u001b[1m\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[0;36m  Summary\u001b[0m\r\n"]
[56.809517, "o", "\u001b[1m\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[57.811881, "o", "  \u001b[1mVarpulis detects attacks that SIEMs miss.\u001b[0m\r\n\r\n  \u001b[2m•\u001b[0m Full APT kill chain detection in \u001b[1mreal-time\u001b[0m\r\n"]
[57.812072, "o", "  \u001b[2m•\u001b[0m \u001b[1mTemporal sequence matching\u001b[0m — not just isolated events\r\n  \u001b[2m•\u001b[0m \u001b[1mBehavioral analysis\u001b[0m — catches renamed/unknown tools\r\n  \u001b[2m•\u001b[0m Native \u001b[1mMITRE ATT&CK\u001b[0m mapping\r\n"]
[57.812552, "o", "  \u001b[2m•\u001b[0m 9K+ events/sec on commodity hardware\r\n\r\n  \u001b[0;36mhttps://github.com/varpulis/varpulis\u001b[0m\r\n\r\n"]
