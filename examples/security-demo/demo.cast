[7.028836, "o", "0"]
[7.061248, "o", "\r\n"]
[7.365919, "o", "# Full APT Kill Chain Detection (4-step sequence)\r\n"]
[7.388118, "o", "# MITRE ATT&CK: T1059 -> T1003 -> T1021 -> T1041\r\n"]
[7.410535, "o", "#\r\n"]
[7.432839, "o", "# Detects the complete kill chain:\r\n"]
[7.455321, "o", "# 1. Initial execution via scripting engine (T1059)\r\n"]
[7.4787, "o", "# 2. Credential dumping via LSASS access (T1003.001)\r\n"]
[7.501321, "o", "# 3. Lateral movement via SMB (T1021.002)\r\n"]
[7.523598, "o", "# 4. Data exfiltration via external connection (T1041)\r\n"]
[7.545894, "o", "\r\n"]
[7.568382, "o", "event SysmonProcessCreate:\r\n"]
[7.591206, "o", "    Image: str\r\n"]
[7.613496, "o", "    CommandLine: str\r\n"]
[7.635849, "o", "    ParentImage: str\r\n"]
[7.658112, "o", "    User: str\r\n"]
[7.680846, "o", "    Hostname: str\r\n"]
[7.703227, "o", "    ProcessId: int\r\n"]
[7.725436, "o", "    ParentProcessId: int\r\n"]
[7.747899, "o", "\r\n"]
[7.770031, "o", "event SysmonProcessAccess:\r\n"]
[7.792518, "o", "    SourceImage: str\r\n"]
[7.814901, "o", "    TargetImage: str\r\n"]
[7.837251, "o", "    GrantedAccess: str\r\n"]
[7.859415, "o", "    CallTrace: str\r\n"]
[7.881981, "o", "    Hostname: str\r\n"]
[7.904734, "o", "    ProcessId: int\r\n"]
[7.927247, "o", "\r\n"]
[7.949857, "o", "event SysmonNetworkConnect:\r\n"]
[7.972534, "o", "    Image: str\r\n"]
[7.995656, "o", "    SourceIp: str\r\n"]
[8.018268, "o", "    DestinationIp: str\r\n"]
[8.040681, "o", "    DestinationPort: int\r\n"]
[8.062893, "o", "    Protocol: str\r\n"]
[8.085884, "o", "    Hostname: str\r\n"]
[8.107988, "o", "    ProcessId: int\r\n"]
[8.130263, "o", "\r\n"]
[8.152526, "o", "# Step 1: Scripting engine execution\r\n"]
[8.174771, "o", "stream ScriptExec = SysmonProcessCreate\r\n"]
[8.197453, "o", "    .where(Image.contains(\"powershell\") or Image.contains(\"cscript\") or Image.contains(\"wscript\") or Image.contains(\"mshta\"))\r\n"]
[8.219585, "o", "\r\n"]
[8.241825, "o", "# Step 2: Credential access (LSASS)\r\n"]
[8.263939, "o", "stream CredAccess = SysmonProcessAccess\r\n"]
[8.286474, "o", "    .where(TargetImage.contains(\"lsass.exe\")\r\n"]
[8.309404, "o", "        and (GrantedAccess == \"0x1010\" or GrantedAccess == \"0x1410\" or GrantedAccess == \"0x1438\" or GrantedAccess == \"0x1fffff\")\r\n"]
[8.332321, "o", "        and not (SourceImage.contains(\"wininit.exe\"))\r\n"]
[8.354847, "o", "        and not (SourceImage.contains(\"csrss.exe\"))\r\n"]
[8.377347, "o", "        and not (SourceImage.contains(\"lsass.exe\")))\r\n"]
[8.399609, "o", "\r\n"]
[8.4224, "o", "# Step 3: Lateral movement (SMB)\r\n"]
[8.445299, "o", "stream SMBLateral = SysmonNetworkConnect\r\n"]
[8.467442, "o", "    .where(DestinationPort == 445)\r\n"]
[11.492401, "o", "\r\n"]
[11.492623, "o", "\u001b[1m\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[0;36m  2. Running Against Real APT29 Attack Data (MORDOR Dataset)\u001b[0m\r\n"]
