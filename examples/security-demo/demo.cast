[0.011412, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.012996, "o", "\r\n\u001b[1m\u001b[0;36m\r\n  ╦  ╦╔═╗╦═╗╔═╗╦ ╦╦  ╦╔═╗\r\n  ╚╗╔╝╠═╣╠╦╝╠═╝║ ║║  ║╚═╗\r\n   ╚╝ ╩ ╩╩╚═╩  ╚═╝╩═╝╩╚═╝\r\n\u001b[0m\r\n  \u001b[1mAPT Kill Chain Detection Demo\u001b[0m\r\n  \u001b[2mDetecting what your SIEM misses\u001b[0m\r\n\r\n"]
[3.014923, "o", "\r\n\u001b[1m\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m\u001b[0;36m  1. The Detection Rule — Full APT Kill Chain\u001b[0m\r\n"]
[3.015274, "o", "\u001b[1m\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[4.017586, "o", "\u001b[2m# A VPL rule that detects the complete attack lifecycle:\u001b[0m\r\n"]
[4.017712, "o", "\u001b[2m# Script execution → Credential theft → Lateral movement → Exfiltration\u001b[0m\r\n\r\n"]
[5.020342, "o", "\u001b[0;32m$ \u001b[0m"]
