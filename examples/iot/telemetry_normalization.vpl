# Varpulis IoT — Telemetry Normalization Pipeline
# Normalizes raw protocol-specific data to standard Measurement events.

# ─── Connectors ───────────────────────────────────────────────

connector NatsBus = mqtt (
    host: "localhost",
    port: 1883,
    client_id: "cep-normalizer"
)

# ─── Event types ──────────────────────────────────────────────
# Raw telemetry carries a protocol-specific `values` map (channel -> reading).

event DeviceTelemetry:
    tenant_id: str
    device_id: str
    device_name: str
    protocol: str
    connector_id: str
    values: {str: float}
    ts: timestamp

# ─── Ingest raw telemetry ─────────────────────────────────────

stream RawTelemetry = DeviceTelemetry
    .from(NatsBus, topic: "varpulis/+/device/telemetry/#")

# ─── Normalize raw telemetry to a standard measurement shape ──
# Raw payloads arrive as a protocol-specific `values` map. We project the known
# channels into a flat, standard shape with explicit fields and units, renaming
# device_id to the canonical source_id.

stream NormalizedMeasurements = RawTelemetry
    .emit(
        tenant_id: tenant_id,
        device_id: device_id,
        source_id: device_id,
        temperature: values["temperature"],
        humidity: values["humidity"],
        unit_temperature: "celsius",
        unit_humidity: "percent",
        ts: ts
    )

# ─── Enrich with device status update ────────────────────────

stream DeviceSeenEvents = RawTelemetry
    .emit(
        tenant_id: tenant_id,
        device_id: device_id,
        device_name: device_name,
        protocol: protocol,
        type: "device_seen",
        text: "Device reported telemetry",
        severity: "info",
        heartbeat: false,
        connector_id: connector_id,
        ts: ts
    )

# ─── Output ──────────────────────────────────────────────────

stream MeasurementsOut = NormalizedMeasurements
    .to(NatsBus, topic: "varpulis/cep/measurements")

stream DeviceSeenOut = DeviceSeenEvents
    .to(NatsBus, topic: "varpulis/cep/device-events")
