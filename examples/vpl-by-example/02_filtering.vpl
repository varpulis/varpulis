# VPL by Example: 02 — Filtering
#
# Demonstrates .where() with various comparison and logical operators:
#   - Comparison: ==, !=, <, >, <=, >=
#   - Logical: and, or, not
#   - String matching
#   - Chained .where() clauses (implicit AND)
#
# Run: varpulis simulate -p 02_filtering.vpl -e 02_filtering.evt -v -w 1

event Order:
    order_id: str
    amount: float
    currency: str
    customer: str

# Simple numeric comparison
stream ExpensiveOrders = Order
    .where(amount > 1000)
    .emit(id: order_id, amount: amount)

# Logical AND — both conditions must be true
stream HighValueUSD = Order
    .where(amount > 500 and currency == "USD")
    .emit(id: order_id, amount: amount, currency: currency)

# Logical OR — either condition triggers
stream FlaggedOrders = Order
    .where(amount > 5000 or currency == "BTC")
    .emit(id: order_id, reason: "flagged")

# Chained .where() — equivalent to AND, but more readable
stream PremiumDomestic = Order
    .where(amount >= 1000)
    .where(currency == "USD")
    .where(customer != "anonymous")
    .emit(id: order_id, customer: customer, amount: amount)
