# VPL by Example: 19 — Stream Joins
#
# join() correlates events from two or more streams by a shared key.
#
# Syntax:
#   stream Result = join(StreamA, StreamB)
#       .on(StreamA.key == StreamB.key)
#       .window(<duration>)
#       .select(field1: StreamA.field, field2: StreamB.field)
#       .emit(field1: field1, field2: field2)
#
# The join buffers events from each side for the given window. When a new event
# matches a buffered one on the join key, the combined row is produced.
#
# TWO THINGS THE JOIN NEEDS, both easy to forget:
#
#   1. .select() SHAPES the joined row; .emit() PUBLISHES it. A join that stops
#      at .select() computes the row and emits nothing. (This example used to
#      end at .select() and produced no output at all.)
#
#   2. The joined streams must actually produce events. A pass-through stream
#      (`stream TempReadings = TemperatureReading`) forwards every event to the
#      join. A *windowed* source stream only reaches the join when its window
#      closes AND it ends in its own .emit(...) — see 05/10 for windows.
#
# Use cases:
#   - Correlate sensor readings from different sources
#   - Enrich events with reference data
#   - Combine metrics from different systems
#
# Run: varpulis simulate -p 19_join.vpl -e 19_join.evt -v -w 1

event TemperatureReading:
    zone: str
    value: float

event HumidityReading:
    zone: str
    value: float

# Pass-through streams: every reading is forwarded to the join buffer.
stream TempReadings = TemperatureReading
stream HumidReadings = HumidityReading

# Join temperature and humidity by zone.
stream ComfortIndex = join(TempReadings, HumidReadings)
    .on(TempReadings.zone == HumidReadings.zone)
    .window(1m)
    .select(
        zone: TempReadings.zone,
        temperature: TempReadings.value,
        humidity: HumidReadings.value,
        comfort: 100 - abs(TempReadings.value - 22) * 5
    )
    .emit(
        zone: zone,
        temperature: temperature,
        humidity: humidity,
        comfort: comfort
    )
