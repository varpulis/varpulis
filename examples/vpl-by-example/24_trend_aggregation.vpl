# VPL by Example: 24 — Trend Aggregation (Statistics over Every Trend)
#
# .trend_aggregate() computes statistics over every trend the pattern
# matches — every non-empty subset of the steps between the start and the
# end — without enumerating them: the counts come from a dynamic programme
# over the window's events (GRETA), quadratic in their number where the
# trends are exponential. One result per partition when its window
# (the .within()) closes.
#
# Syntax:
#   .trend_aggregate(
#       name: avg_trends(alias.field),
#       name: sum_trends(alias.field),
#       name: max_trends(alias.field),
#       name: min_trends(alias.field),
#       name: count_events(alias),
#       name: count_trends()
#   )
#
# Functions (here: three steps, so 7 trends, each step in 4 of them):
#   count_trends()            Number of trends: 7
#   count_events(alias)       Times the step's events take part in a trend,
#                             summed over the trends: 3 steps x 4 = 12
#                             (count(steps) in .emit() gives the 3 distinct)
#   sum_trends(alias.field)   The field summed over every step of every
#                             trend: 4 x (1200 + 3400 + 800) = 21600
#   avg_trends(alias.field)   sum_trends / count_trends: 3085.7
#   max_trends(alias.field)   Largest value of the field on a step in a trend
#   min_trends(alias.field)   Smallest such value
#
#   The alias is required on the field aggregates: it names the pattern step
#   the field is read from. A bare `sum_trends(field)` is refused at compile
#   time — it used to be dropped silently, producing no output field at all.
#
# Use cases:
#   - Transaction pipeline monitoring
#   - Multi-step process analysis
#   - Batch operation statistics
#
# Aggregate output fields can be filtered with .where() downstream:
#   .trend_aggregate(total: sum_trends(...))
#   .where(total > 1000)            # works on the aggregate result
#
# Run: varpulis simulate -p 24_trend_aggregation.vpl -e 24_trend_aggregation.evt -v -w 1

event BatchStart:
    batch_id: str
    source: str

event BatchStep:
    batch_id: str
    step: str
    duration: float
    errors: int

event BatchEnd:
    batch_id: str
    status: str

stream BatchAnalytics = BatchStart as start
    -> all BatchStep where batch_id == start.batch_id as steps
    -> BatchEnd where batch_id == start.batch_id as done
    .within(30m)
    .partition_by(batch_id)
    .trend_aggregate(
        avg_duration: avg_trends(steps.duration),
        max_errors: max_trends(steps.errors),
        total_duration: sum_trends(steps.duration),
        step_count: count_events(steps),
        trend_count: count_trends()
    )
    .where(total_duration > 1000)
    .emit(
        batch_id: start.batch_id,
        source: start.source,
        status: done.status,
        avg_step_duration: avg_duration,
        max_step_errors: max_errors,
        total_duration: total_duration,
        steps: step_count,
        distinct_steps: count(steps),
        trends: trend_count
    )
