# VPL by Example: 14 — Negation (Absence of an Interfering Event)
#
# .not() invalidates an in-flight pattern run when a forbidden event arrives.
# Read it as: "A, then B, but NOT C in between."
#
# Syntax:
#   A as a
#     -> B where <condition> as b
#     .within(<duration>)
#     .not(C where <condition>)
#
# IMPORTANT — .not() is a CANCELLATION operator, not a timeout operator.
# It cannot express "A happened and B never did": with no event to trigger it,
# there is nothing for the engine to emit. In particular, naming the SAME event
# type in both the sequence step and the .not() is self-contradictory —
#
#     -> Payment where order_id == order.id
#     .not(Payment where order_id == order.id)   # <-- never fires
#
# because the very event that completes the match is also the one that cancels
# it. (This example used to be written that way and emitted nothing.)
#
# Use cases:
#   - Order paid, unless it was cancelled first
#   - Alert raised and acknowledged, unless it was suppressed in between
#   - Login followed by a purchase, unless the session was revoked
#
# Run: varpulis simulate -p 14_negation.vpl -e 14_negation.evt -v -w 1

event Order:
    id: int
    customer: str
    amount: float

event Payment:
    order_id: int
    amount: float

event Cancellation:
    order_id: int
    reason: str

# Confirm an order when its payment arrives — unless a cancellation for the
# same order landed in between, which kills the run before the payment can
# complete it.
stream ConfirmedOrders = Order as order
    -> Payment where order_id == order.id as payment
    .within(5m)
    .not(Cancellation where order_id == order.id)
    .emit(
        alert: "order_confirmed",
        order_id: order.id,
        customer: order.customer,
        amount: payment.amount
    )
