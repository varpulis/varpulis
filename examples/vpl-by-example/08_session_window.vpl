# VPL by Example: 08 — Session Window
#
# A session window groups events based on activity. The window closes when
# no events arrive for a specified inactivity gap.
#
# Syntax: .window(session: <gap_duration>)
#   - .window(session: 5s) → close after 5 seconds of inactivity
#
# Timeline (5s gap):
#   Events: *  *  *     (5s silence)     *  *     (5s silence)
#           |--session 1--|               |--session 2--|
#
# Use cases: user sessions, machine operating cycles, conversation threads.
#
# Run: varpulis simulate -p 08_session_window.vpl -e 08_session_window.evt -v -w 1

event ClickEvent:
    user_id: str
    page: str

stream UserSessions = ClickEvent
    .partition_by(user_id)
    .window(session: 5s)
    .aggregate(
        clicks: count(),
        first_page: first(page),
        last_page: last(page)
    )
    .emit(
        user: user_id,
        clicks: clicks,
        first_page: first_page,
        last_page: last_page
    )
