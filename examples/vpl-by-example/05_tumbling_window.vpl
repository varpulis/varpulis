# VPL by Example: 05 — Tumbling Time Window
#
# A tumbling window collects events into fixed-size, non-overlapping buckets.
# When the window closes, all collected events are processed together.
#
# Syntax: .window(<duration>)
#   Duration units: s (seconds), m (minutes), h (hours), d (days)
#
# Common use: compute aggregates over fixed time intervals.
#
# Timeline:
#   |--- window 1 ---|--- window 2 ---|--- window 3 ---|
#   0s              5s              10s              15s
#
# Run: varpulis simulate -p 05_tumbling_window.vpl -e 05_tumbling_window.evt -v -w 1

event SensorReading:
    sensor_id: str
    temperature: float

stream AvgTemperature = SensorReading
    .window(5s)
    .aggregate(
        avg_temp: avg(temperature),
        min_temp: min(temperature),
        max_temp: max(temperature),
        readings: count()
    )
    .emit(
        avg_temp: avg_temp,
        min_temp: min_temp,
        max_temp: max_temp,
        readings: readings
    )
