# Transaction Monitoring with Kleene Closure + Trend Aggregation
#
# Demonstrates monitoring multi-step transactions where:
# - TransactionOpen starts a transaction
# - ProcessingStep+ captures one or more intermediate steps (Kleene closure)
# - TransactionClose completes the transaction
#
# .trend_aggregate() computes statistics over every trend the pattern
# matches — every non-empty subset of the steps, with the open and the
# close — without enumerating them: the counts come from a dynamic
# programme over the window's events (GRETA), quadratic in their number
# where the trends are exponential.

# =============================================================================
# Event Definitions
# =============================================================================

event TransactionOpen:
    tx_id: str
    customer_id: str
    channel: str
    ts: timestamp

event ProcessingStep:
    tx_id: str
    step_name: str
    duration: float
    error_count: int
    throughput: float
    status: str
    ts: timestamp

event TransactionClose:
    tx_id: str
    final_status: str
    ts: timestamp

# =============================================================================
# Stream 1: Trend Aggregation — Aggregate Step Statistics per Transaction
# =============================================================================
#
# Pattern: TransactionOpen -> ProcessingStep+ -> TransactionClose
#
# The Kleene closure (all) captures every intermediate processing step.
# With n steps there are 2^n - 1 trends, one per non-empty subset of the
# steps; each step takes part in 2^(n-1) of them. The aggregates sum over
# the trends:
#   - avg_dur:     sum_trends(steps.duration) / count_trends()
#   - max_errors:  the largest error_count of a step in a trend
#   - total_tput:  throughput summed over every step of every trend
#   - step_count:  count_events(steps): a step counts once per trend it is in
#                  (four steps give 4 * 8 = 32); count(steps) in .emit() gives
#                  the distinct steps, 4
#   - trend_count: the number of trends (2^n - 1)
#
# One result per transaction when its window closes: when an event arrives
# 30 minutes after the transaction opened, when the event clock passes that
# point, or at the end of the input.

stream TransactionStats = TransactionOpen as open
    -> all ProcessingStep as steps
    -> TransactionClose as close
    .within(30m)
    .partition_by(tx_id)
    .trend_aggregate(
        avg_dur: avg_trends(steps.duration),
        max_errors: max_trends(steps.error_count),
        total_tput: sum_trends(steps.throughput),
        step_count: count_events(steps),
        trend_count: count_trends()
    )
    .emit(
        event_type: "TransactionSummary",
        tx_id: open.tx_id,
        channel: open.channel,
        avg_duration: avg_dur,
        max_error_count: max_errors,
        total_throughput: total_tput,
        steps: step_count,
        distinct_steps: count(steps),
        trends: trend_count
    )

# =============================================================================
# Stream 2: Detection — Slow Transaction Step Detection (SASE+)
# =============================================================================
#
# This companion stream uses the SASE+ engine (no .trend_aggregate()) to
# detect individual slow processing steps within a transaction. This shows
# how the same Kleene pattern can be used for both detection and aggregation.

stream SlowTransactionStep = TransactionOpen as open
    -> all ProcessingStep where duration > 5000.0 as slow_step
    .within(30m)
    .partition_by(tx_id)
    .emit(
        event_type: "SlowStepAlert",
        tx_id: open.tx_id,
        step_name: slow_step.step_name,
        duration: slow_step.duration,
        severity: "warning"
    )

# =============================================================================
# Stream 3: Aggregation by Channel, over the summaries
# =============================================================================
#
# A trend aggregate is partitioned by a field every event of the pattern
# carries (tx_id above); the channel is on TransactionOpen alone. The
# per-channel view reads the summaries, which carry it, and aggregates them
# under a window of their own.

stream ChannelStats = TransactionStats
    .partition_by(channel)
    .window(1h)
    .aggregate(
        transactions: count(),
        avg_trends: avg(trends),
        avg_step_duration: avg(avg_duration)
    )
    .emit(
        event_type: "ChannelSummary",
        channel: _partition,
        transactions: transactions,
        avg_trends: avg_trends,
        avg_step_duration: avg_step_duration
    )
