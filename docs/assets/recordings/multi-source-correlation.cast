{"version": 2, "width": 100, "height": 38, "timestamp": 1774654024, "env": {"SHELL": "/usr/bin/zsh", "TERM": "xterm-256color"}}
[0.00745, "o", "\r\n  ╔═══════════════════════════════════════════════════════════════╗\r\n  ║  Varpulis Multi-Source Correlation Demo                      ║\r\n  ║  Real MQTT broker (Mosquitto) • Live event processing        ║\r\n  ╚═══════════════════════════════════════════════════════════════╝\r\n\r\n"]
[1.510265, "o", "\u001b[1;37m$ cat pipeline.vpl\u001b[0m\r\n"]
[2.013202, "o", "\u001b[36mconnector MqttBroker = mqtt(host: \"localhost\", port: 1883)\u001b[0m\r\n\r\n\u001b[36mstream HotDevices = SensorReading\u001b[0m\r\n\u001b[36m    .from(MqttBroker, topic: \"devices/sensors\")\u001b[0m\r\n\u001b[36m    .where(temperature > 80)\u001b[0m\r\n\r\n\u001b[36mstream LargePayments = Transaction\u001b[0m\r\n"]
[2.013397, "o", "\u001b[36m    .from(MqttBroker, topic: \"payments/transactions\")\u001b[0m\r\n\u001b[36m    .where(amount > 5000)\u001b[0m\r\n"]
[4.015807, "o", "\r\n\u001b[1;37m$ varpulis run --file pipeline.vpl\u001b[0m\r\n"]
[4.829782, "o", "\r\nProgram loaded successfully!\r\n   Streams registered: 3\r\n\r\nmqtt source: MqttBroker topic=devices/sensors\r\n"]
[4.830114, "o", "\r\nmqtt source: MqttBroker topic=payments/transactions\r\n\r\nListening for events...\r\n   Press Ctrl+C to stop\r\n\r\n"]
[6.821129, "o", "\r\n\u001b[2m── Publishing events to MQTT from another terminal ──\u001b[0m\r\n"]
[7.823743, "o", "\r\n\u001b[33m📡 MQTT → devices/sensors:\u001b[0m SensorReading { device_id: \"POS-42\", temperature: 65.0 }\r\n"]
[8.437272, "o", "  \u001b[2m→ temperature 65°F — normal, no alert\u001b[0m\r\n"]
[9.639814, "o", "\r\n\u001b[33m📡 MQTT → devices/sensors:\u001b[0m SensorReading { device_id: \"POS-42\", temperature: \u001b[1;31m92.3\u001b[0m }\r\n"]
[9.740995, "o", "OUTPUT EVENT: HotDevices - {\"device\": Str(\"POS-42\"), \"temp\": Float(92.3), \"loc\": Str(\"store-7\")}\r\n"]
[10.257395, "o", "  \u001b[1;33m⚡ HotDevices matched!\u001b[0m { device: \"POS-42\", temp: 92.3 }\r\n"]
[11.759564, "o", "\r\n\u001b[33m📡 MQTT → payments/transactions:\u001b[0m Transaction { device_id: \"POS-77\", amount: 8500 }\r\n"]
[11.880935, "o", "OUTPUT EVENT: LargePayments - {\"device\": Str(\"POS-77\"), \"amount\": Float(8500.0), \"merchant\": Str(\"electronics\")}\r\n"]
[12.400234, "o", "  \u001b[1;33m⚡ LargePayments matched!\u001b[0m { device: \"POS-77\", amount: 8500 }\r\n  \u001b[2m→ different device — no correlation with POS-42\u001b[0m\r\n"]
[13.902403, "o", "\r\n\u001b[33m📡 MQTT → payments/transactions:\u001b[0m Transaction { device_id: \"\u001b[1;31mPOS-42\u001b[0m\", amount: \u001b[1;31m12750\u001b[0m }\r\n"]
[14.002571, "o", "OUTPUT EVENT: LargePayments - {\"device\": Str(\"POS-42\"), \"amount\": Float(12750.0), \"merchant\": Str(\"luxury-goods\")}\r\n"]
[14.519825, "o", "  \u001b[1;33m⚡ LargePayments matched!\u001b[0m { device: \"POS-42\", amount: 12750 }\r\n"]
[15.022607, "o", "\r\n  \u001b[1;31m🚨 CORRELATION: overheating POS-42 (92.3°F) + $12,750 payment at luxury-goods\u001b[0m\r\n  \u001b[1;31m   → SuspiciousActivity alert emitted\u001b[0m\r\n"]
[17.025302, "o", "\r\n\u001b[2m── 3 streams processed • 2 sources • 1 correlation match ──\u001b[0m\r\n"]
